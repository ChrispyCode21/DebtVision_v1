{
  "checks": {
    "fast": "npm run check:fast",
    "install": "npm ci"
  },
  "builder": {
    "milestones": "semver",
    "authors": "owner",
    "branchPrefix": "agent/issue-",
    "docs": ["SPEC.md", "CLAUDE.md", "ARCHITECTURE.md"],
    "spec": { "path": "SPEC.md", "recordDecisionsFirst": true },
    "workedExamples": { "paths": ["src/engine/"], "approveOnIssue": true, "section": "SPEC.md §7" },
    "neverEdit": [".github/workflows/", ".github/rulesets/", ".claude/"]
  },
  "reviewer": {
    "authors": ["agent", "app/dependabot", "app/claude"],
    "highRisk": {
      "paths": ["src/engine/", "src/services/storage", "worker/", "migrations/"],
      "labels": ["touches-data", "touches-gates", "high-risk"]
    },
    "ownerMerges": {
      "labels": ["touches-data", "touches-gates"],
      "release": true,
      "dependabotWorkflows": true
    },
    "mergeNotes": {
      "touches-data": "Changes the saved-data shape or its migration. Check old saves still load (storage tests) before merging: users' data lives only in their browsers' localStorage.",
      "touches-gates": "It changes what decides green (lint, type or test config, workflows or rulesets): read those files, not just the result."
    },
    "mergeMethod": "merge"
  },
  "standards": {
    "baseline": true,
    "rules": ["CLAUDE.md", "ARCHITECTURE.md"],
    "exceptions": []
  }
}
